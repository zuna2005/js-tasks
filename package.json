{
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11"
  },
  "scripts": {
    "prepare": "husky",
    "lint-backend": "cd messenger-app/backend && npm run lint",
    "format-backend": "cd messenger-app/backend && npm run format",
    "lint-frontend": "cd messenger-app/frontend && npm run lint",
    "format-frontend": "cd messenger-app/frontend && npm run format"
  },
  "lint-staged": {
    "messenger-app/backend/**": [
      "npm run lint-backend",
      "npm run format-backend"
    ],
    "messenger-app/frontend/**": [
      "npm run lint-frontend",
      "npm run format-frontend"
    ]
  }
}
